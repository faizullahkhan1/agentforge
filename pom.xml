<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Spring Boot 3.5.x: the line LangChain4j's Spring starters are built against -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>dev.agentforge</groupId>
    <artifactId>agentforge-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>AgentForge</name>
    <description>Java agent orchestration engine and the apps built on it</description>

    <!-- Each app/library is a module. agentforge-core (the shared engine) gets extracted in Phase 4. -->
    <modules>
        <module>pr-reviewer</module>
        <module>invoice-processor</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <langchain4j.version>1.23.0</langchain4j.version>
        <langchain4j-spring.version>1.23.0-beta33</langchain4j-spring.version>
        <pdfbox.version>3.0.8</pdfbox.version>
        <!-- Evals call the real OpenAI API (costs money, results vary), so they are skipped unless -Peval -->
        <test.excludedGroups>eval</test.excludedGroups>
        <test.groups></test.groups>
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <excludedGroups>${test.excludedGroups}</excludedGroups>
                        <groups>${test.groups}</groups>
                        <!-- Surefire's defaults only pick up *Test / *Tests / *TestCase classes; add *Eval.
                             The eval tag above still keeps them out of normal runs. -->
                        <includes>
                            <include>**/*Test.java</include>
                            <include>**/*Tests.java</include>
                            <include>**/*Eval.java</include>
                        </includes>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <!-- mvn -Peval test -pl pr-reviewer   (options: -Deval.runs=3, see each *Eval class) -->
        <profile>
            <id>eval</id>
            <properties>
                <test.excludedGroups></test.excludedGroups>
                <test.groups>eval</test.groups>
            </properties>
        </profile>
    </profiles>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>dev.langchain4j</groupId>
                <artifactId>langchain4j-bom</artifactId>
                <version>${langchain4j.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>dev.langchain4j</groupId>
                <artifactId>langchain4j-spring-boot-starter</artifactId>
                <version>${langchain4j-spring.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.langchain4j</groupId>
                <artifactId>langchain4j-open-ai-spring-boot-starter</artifactId>
                <version>${langchain4j-spring.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.pdfbox</groupId>
                <artifactId>pdfbox</artifactId>
                <version>${pdfbox.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
