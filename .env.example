# Copy this file to ".env" (same folder) and fill in your values.
# .env is in .gitignore and .dockerignore, so it never reaches GitHub or a Docker image.

OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
# The judge makes one call per review, so it gets a stronger model
OPENAI_JUDGE_MODEL=gpt-4.1

# GitHub fine-grained token with "Pull requests: Read and write" + "Contents: Read" on your test repo.
# Leave empty to only dry-run public PRs.
GITHUB_TOKEN=

# Webhooks: SMEE_URL from https://smee.io/new, secret = any long random string,
# and the same secret goes into the GitHub repo's webhook settings.
SMEE_URL=
GITHUB_WEBHOOK_SECRET=

# Cost limits per PR: every reviewed file costs 4 LLM calls
REVIEW_MAX_FILES=5
REVIEW_MAX_LINES=800

# Port on your PC where the app is reachable (http://localhost:8090)
APP_PORT=8090

POSTGRES_USER=agentforge
POSTGRES_PASSWORD=agentforge
