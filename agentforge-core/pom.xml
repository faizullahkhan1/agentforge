<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.agentforge</groupId>
        <artifactId>agentforge-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>agentforge-core</artifactId>
    <name>AgentForge Core</name>
    <description>Building blocks shared by the AgentForge apps: model setup, parallel agent calls, step timing, eval helpers</description>

    <!-- A plain library jar: no Spring Boot app, no spring-boot-maven-plugin -->
    <dependencies>
        <!-- provided: core compiles against LangChain4j, but each app brings its own copy through the
             Spring Boot starter. As a normal dependency it also pulled in LangChain4j's JDK HTTP client,
             next to the starter's Spring RestClient one, and the OpenAI builder then refused to start
             ("multiple HTTP clients have been found in the classpath"). -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-open-ai</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
